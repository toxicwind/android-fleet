# ranch/android-fleet/phone-backup — project-owned daemon manifest.
# arrival-classifier: event-driven (inotify) classifier for Syncthing incoming/.
# Watches /mnt/8TB/phone-archive/incoming/ with a 5s settle debounce; routes
# arrivals to repos/, archives/, code/, docs/ under /mnt/8TB/phone-archive/.
# Photos (DCIM/Pictures/media) and credential-shaped content are never
# auto-routed — left in incoming/ for manual review.

[daemons.arrival-classifier]
run = "exec /home/toxic/.bun/bin/bun /home/toxic/estate/ranch/android-fleet/phone-backup/arrival-classifier.ts"
dir = "/home/toxic/estate/ranch/android-fleet/phone-backup"
mise = false
retry = true
auto = ["start"]
