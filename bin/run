#!/usr/bin/env bash
# android-fleet — ADB-managed Android device orchestration rig (bin/run).
# Primary operation: hold the Pixel's adb session over LAN wireless debugging
# via bin/pixel-adb-keepalive.sh (a keepalive loop that rediscovers the rotating
# wireless-debugging port). NOTE: live supervision moved to phone-lane-keeper.service;
# this script is the canonical reference / manual operation.
# Usage: bin/run
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== android-fleet run: starting pixel-adb keepalive =="
echo "  (live fleet supervision runs under phone-lane-keeper.service; this is the canonical loop.)"
exec bin/pixel-adb-keepalive.sh