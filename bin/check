#!/usr/bin/env bash
# android-fleet — ADB-managed Android device orchestration rig (bin/check).
# Self-test gate (PASS / FAIL / WARN). Read-only (never disturbs devices):
#   1. keepalive script passes bash -n (syntax integrity).
#   2. adb is present; `adb devices` enumerates reachable devices (report only).
#   3. Notes supervision home (phone-lane-keeper.service supersedes the in-repo
#      keepalive for live operation since 2026-09-20).
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== android-fleet check: start =="

echo "-- keepalive syntax --"
bash -n bin/pixel-adb-keepalive.sh || { echo "FAIL: bin/pixel-adb-keepalive.sh syntax"; exit 1; }
echo "OK: bin/pixel-adb-keepalive.sh syntax valid"

echo "-- adb tooling --"
if command -v adb >/dev/null 2>&1 && adb version >/dev/null 2>&1; then
  echo "OK: adb present ($(adb version 2>/dev/null | head -1))"
else
  echo "WARN: adb not available on PATH"
fi

echo "-- device surface (read-only adb devices) --"
if command -v adb >/dev/null 2>&1; then
  out="$(timeout 10 adb devices 2>/dev/null || true)"
  echo "$out" | grep -vE "^List|^$" | head -10
  [ -n "$(echo "$out" | grep -E '\bdevice\b' | head -1)" ] && echo "OK: >=1 device reachable" || echo "WARN: no device currently 'device' (expected if phone off LAN)"
fi

echo "-- supervision home --"
echo "  Live supervision: phone-lane-keeper.service (supersedes in-repo keepalive 2026-09-20)"
if systemctl --user list-units 2>/dev/null | grep -q phone-lane-keeper; then
  echo "  phone-lane-keeper.service: present"
else
  echo "  phone-lane-keeper.service: not found under user systemd (WARN)"
fi

echo "== android-fleet check: PASS =="