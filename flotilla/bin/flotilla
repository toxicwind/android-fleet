#!/usr/bin/env bash
# flotilla — floating freeform windows on the android-fleet Pixel (PiP-style side windows).
#
# Owns: freeform enablement, windowed launch of any app/URL, bounds (move/resize
# via am stack resize), focus reporting, dark mode.
#
# Device: Pixel 9 Pro XL (android-fleet docs/devices.md), adb wireless.
# Focus doctrine: adb input lands on the FOCUSED window. flotilla floats windows;
# it never taps or types — presses belong to the human holding the phone.
set -euo pipefail

DEVICE="${FLOTILLA_DEVICE:-10.0.0.77:43945}"
ADB="adb -s ${DEVICE}"

usage() {
  cat <<'EOF'
flotilla — floating freeform windows on the fleet Pixel

Usage:
  flotilla open <url> [app-package]      # launch URL in a freeform (floating) window
                                         #   app defaults to Firefox (org.mozilla.fenix)
  flotilla bounds <taskId> L,T,R,B       # move/resize a floating window
  flotilla list                          # list windows + tasks with ids for bounds
  flotilla focus                         # who owns the screen right now
  flotilla dark on|off                   # system dark mode (affects floated pages)
  flotilla enable                        # idempotent: ensure freeform support is on

Env: FLOTILLA_DEVICE (default 10.0.0.77:43945)
EOF
  exit 1
}

[ $# -ge 1 ] || usage
cmd="$1"; shift || true

case "$cmd" in
  enable)
    $ADB shell settings put global enable_freeform_support 1
    echo "freeform: enabled (idempotent)"
    ;;
  open)
    url="${1:?usage: flotilla open <url> [app-package]}"; shift
    app="${1:-org.mozilla.fenix}"
    launched=$($ADB shell am start -a android.intent.action.VIEW -d "$url" -p "$app" --windowingMode 5)
    echo "am: ${launched//[$'\r']/}"
    # report the new task id for bounds control
    sleep 1
    tid=$($ADB shell am stack list | grep -A2 "$app" | grep -m1 -oE 'taskId=[0-9]+' | cut -d= -f2)
    echo "floated: $url in $app (taskId=${tid:-?})"
    ;;
  bounds)
    tid="${1:?usage: flotilla bounds <taskId> L,T,R,B}"; shift
    rect="${1:?usage: flotilla bounds <taskId> L,T,R,B}"
    $ADB shell am stack resize "$tid" "${rect/,/ }" && echo "bounds: task $tid -> $rect"
    ;;
  list)
    $ADB shell am stack list
    ;;
  focus)
    $ADB shell dumpsys window | grep -E 'mCurrentFocus|mFocusedApp'
    ;;
  dark)
    mode="${1:?usage: flotilla dark on|off}"
    case "$mode" in
      on)  $ADB shell cmd uimode night yes ;;
      off) $ADB shell cmd uimode night no ;;
      *)   usage ;;
    esac
    echo "dark: $mode"
    ;;
  *) usage ;;
esac
