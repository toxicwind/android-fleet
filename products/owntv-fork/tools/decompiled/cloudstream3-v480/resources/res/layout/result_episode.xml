<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/episode_holder"
    android:nextFocusRight="@+id/download_button"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginBottom="5dp"
    android:foreground="@drawable/outline_drawable"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="@dimen/rounded_image_radius"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/watch_progress_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp">
            <ImageView
                android:id="@+id/episode_play_icon"
                android:layout_margin="4dp"
                style="@style/ContinueWatchingPlayUnderlayProgress"/>
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/episode_progress"
                style="@style/ContinueWatchingCircularProgress"/>
        </FrameLayout>
        <com.google.android.material.button.MaterialButton
            android:layout_gravity="center"
            android:id="@+id/episode_filler"
            android:text="@string/filler"
            style="@style/SmallWhiteButton"/>
        <TextView
            android:textColor="?attr/textColor"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/episode_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="0"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="50dp"/>
        <com.lagradost.cloudstream3.ui.download.button.PieFetchButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/download_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:layout_width="@dimen/download_size"
            android:layout_height="@dimen/download_size"
            android:layout_marginStart="-60dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
