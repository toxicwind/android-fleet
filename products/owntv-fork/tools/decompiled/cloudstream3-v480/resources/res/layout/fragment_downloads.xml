<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/download_root"
    android:background="?attr/primaryGrayBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="?attr/primaryGrayBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/download_delete_appbar"
            android:background="?attr/primaryGrayBackground"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/btnCancel"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:nextFocusLeft="@+id/navigation_downloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_close_24"
                android:contentDescription="@string/cancel"
                app:tint="?attr/white"/>
            <Button
                android:textColor="?attr/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/btnDelete"
                android:background="?attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"/>
            <TextView
                android:textColor="?attr/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/selectItemsText"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/downloads_delete_select"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <Button
                android:textColor="?attr/white"
                android:id="@+id/btnToggleAll"
                android:background="?attr/selectableItemBackground"
                android:nextFocusDown="@+id/download_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_all"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/download_appbar"
            android:background="?attr/primaryGrayBackground"
            android:focusable="true"
            android:nextFocusLeft="@+id/navigation_downloads"
            android:nextFocusRight="@+id/download_stream_button_tv"
            android:nextFocusDown="@+id/download_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/outline_drawable"
            android:baselineAligned="false">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/download_storage_appbar"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_weight="1">
                <TextView
                    android:textColor="?attr/textColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/download_storage_text"/>
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/download_loading_bytes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shimmer_auto_start="true"
                    app:shimmer_base_alpha="0.2"
                    app:shimmer_duration="@integer/loading_time"
                    app:shimmer_highlight_alpha="0.3">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include layout="@layout/loading_line"/>
                        <include layout="@layout/loading_line_short"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/download_bytes_bar"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginBottom="5dp"
                        android:elevation="0dp"
                        app:cardCornerRadius="@dimen/storage_radius"
                        app:cardElevation="0dp"
                        app:cardMaxElevation="0dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <View
                                android:id="@+id/download_used"
                                android:background="@drawable/storage_bar_left"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.5"/>
                            <View
                                android:id="@+id/download_app"
                                android:background="@drawable/storage_bar_mid"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.1"/>
                            <View
                                android:id="@+id/download_free"
                                android:background="@drawable/storage_bar_right"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.1"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/storage_bar_left_box"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_marginEnd="5dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="?attr/textColor"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/download_used_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/storage_bar_mid_box"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_margin="5dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="?attr/textColor"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/download_app_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/storage_bar_right_box"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_margin="5dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="?attr/textColor"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/download_free_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/steam_imageview_holder"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <TextView
                    android:textColor="?attr/textColor"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stream"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/download_stream_button_tv"
                    android:background="@drawable/outline_drawable"
                    android:padding="8dp"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/download_appbar"
                    android:nextFocusDown="@+id/download_list"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_network_stream"
                    android:contentDescription="@string/stream"
                    app:tint="?attr/textColor"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:background="?attr/primaryBlackBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/download_loading"
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.2"
            app:shimmer_duration="@integer/loading_time"
            app:shimmer_highlight_alpha="0.3">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/loading_margin"
                android:layout_marginEnd="@dimen/loading_margin">
                <include layout="@layout/loading_downloads"/>
                <include layout="@layout/loading_downloads"/>
                <include layout="@layout/loading_downloads"/>
                <include layout="@layout/loading_downloads"/>
                <include layout="@layout/loading_downloads"/>
                <include layout="@layout/loading_downloads"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/download_list"
            android:tag="@string/tv_no_focus_tag"
            android:paddingBottom="100dp"
            android:nextFocusLeft="@+id/navigation_downloads"
            android:nextFocusUp="@+id/download_stream_button_tv"
            android:nextFocusDown="@+id/download_queue_button"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/download_queue_button"
            android:background="?attr/primaryGrayBackground"
            android:focusable="true"
            android:nextFocusUp="@+id/download_list"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:foreground="@drawable/outline_drawable">
            <ImageView
                android:layout_gravity="center"
                android:paddingTop="5dp"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/round_keyboard_arrow_up_24"/>
            <TextView
                android:textColor="?attr/textColor"
                android:gravity="center"
                android:id="@+id/download_queue_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_queue"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/text_no_downloads"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="@string/downloads_empty"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp">
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_gravity="end|bottom"
            android:id="@+id/open_local_video_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/netflix_play"
            android:contentDescription="@string/open_local_video"
            android:layout_marginEnd="16dp"
            android:backgroundTint="?attr/primaryGrayBackground"
            android:tooltipText="@string/open_local_video"
            app:tint="?attr/textColor"
            style="?attr/floatingActionButtonSmallStyle"/>
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:textColor="?attr/textColor"
            android:id="@+id/download_stream_button"
            android:text="@string/stream"
            android:contentDescription="@string/stream"
            app:icon="@drawable/ic_network_stream"
            style="@style/ExtendedFloatingActionButton"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
