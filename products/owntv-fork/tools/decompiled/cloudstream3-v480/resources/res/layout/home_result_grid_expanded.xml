<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:foreground="@drawable/outline_drawable"
    android:backgroundTint="@color/transparent"
    app:cardCornerRadius="@dimen/rounded_image_radius"
    app:cardElevation="0dp">
    <ImageView
        android:id="@+id/title_shadow"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/background_card"
            android:layout_width="114dp"
            android:layout_height="180dp"
            android:elevation="10dp"
            app:cardBackgroundColor="?attr/primaryGrayBackground"
            app:cardCornerRadius="@dimen/rounded_image_radius">
            <ImageView
                android:id="@+id/imageView"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerCrop"
                android:contentDescription="@string/search_poster_img_des"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/watch_progress_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/search_item_download_play"
                    style="@style/HomePlayUnderlayProgress"/>
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/watchProgress"
                    style="@style/HomeCircularProgress"/>
            </FrameLayout>
            <TextView
                android:id="@+id/text_quality"
                style="@style/TypeButton"/>
            <LinearLayout
                android:layout_gravity="end"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <TextView
                    android:layout_gravity="end"
                    android:id="@+id/text_is_dub"
                    style="@style/DubButton"/>
                <TextView
                    android:layout_gravity="end"
                    android:id="@+id/text_is_sub"
                    style="@style/SubButton"/>
                <TextView
                    android:layout_gravity="end"
                    android:id="@+id/text_rating"
                    style="@style/RatingButton"/>
                <TextView
                    android:textSize="20sp"
                    android:layout_gravity="end"
                    android:id="@+id/text_flag"
                    android:background="@color/transparent"
                    android:visibility="gone"
                    style="@style/SearchBox"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_gravity="center"
                    android:id="@+id/episode_text"
                    android:layout_width="wrap_content"
                    style="@style/EpisodeTextButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/textColor"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/imageText"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:minLines="2"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
