<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/nav_footer_root"
    android:padding="1dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/nav_footer_profile_card"
        android:background="@color/transparent"
        android:focusable="true"
        android:nextFocusUp="@+id/navigation_settings"
        android:nextFocusDown="@+id/nav_footer_profile_card"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:foreground="@drawable/outline_drawable_round_20"
        app:cardCornerRadius="18dp">
        <ImageView
            android:id="@+id/nav_footer_profile_pic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/outline_big_20_gray"
            android:scaleType="centerCrop"
            android:contentDescription="@string/account"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
